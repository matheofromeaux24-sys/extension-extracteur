{
  "name": "scrapy-easy",
  "private": true,
  "version": "0.1.0",
  "description": "Extension Chrome de web scraping sans code",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "test:detection": "node scripts/test-detection.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "serve:test": "npx --yes serve test-pages -l 5173"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-virtual": "^3.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "playwright": "1.56.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
